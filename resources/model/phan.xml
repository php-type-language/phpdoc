<?xml version="1.0" encoding="UTF-8"?>
<model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="phpdoc.xsd"
       package="phan">
    <package name="phan" class="TypeLang\PhpDoc\Platform\PhanPlatform" title="Phan">
        <description>
            The Phan platform: the `@phan-*` tag family understood by Phan.

            A prefixed tag that restates a common one gets the definition of that tag,
            Phan's own marker tags are contributed as their own flag definitions.
        </description>
    </package>

    <tag name="phan-closure-scope" class="TypeLang\PhpDoc\DocBlock\Tag\PhanClosureScopeTag\PhanClosureScopeTag" extends="TypeLang\PhpDoc\DocBlock\Tag\TypedTag" placement="block">
        <summary>
            The `@phan-closure-scope` tag binds the type of `$this` inside a
            `Closure`, so the closure body is analyzed as though bound to an
            instance of the given class.
        </summary>
        <grammar>
            <sequence>
                <rule name="Type" as="type" parameter="statement"/>
                <maybe>
                    <rule name="Description" as="description"/>
                </maybe>
            </sequence>
        </grammar>
    </tag>

    <tag name="phan-constructor-used-for-side-effects" class="TypeLang\PhpDoc\DocBlock\Tag\PhanConstructorUsedForSideEffectsTag\PhanConstructorUsedForSideEffectsTag" extends="TypeLang\PhpDoc\DocBlock\Tag\FlagTag" placement="block">
        <summary>
            The `@phan-constructor-used-for-side-effects` tag declares that a
            constructor's return value is intentionally discarded by callers,
            suppressing the issue raised for an unused `new` expression.
        </summary>
        <grammar>
            <maybe>
                <rule name="Description" as="description"/>
            </maybe>
        </grammar>
    </tag>

    <tag name="phan-file-suppress" class="TypeLang\PhpDoc\DocBlock\Tag\PhanFileSuppressTag\PhanFileSuppressTag" extends="TypeLang\PhpDoc\DocBlock\Tag\IssueListTag" placement="block">
        <summary>
            The `@phan-file-suppress` tag silences the listed issue types for the
            whole file it appears in, rather than just a single element or line.
        </summary>
        <grammar>
            <sequence>
                <rule name="IssueName" as="issue" parameter="issues"/>
                <repeat>
                    <sequence>
                        <literal value=","/>
                        <rule name="IssueName" as="issue" parameter="issues"/>
                    </sequence>
                </repeat>
                <maybe>
                    <rule name="Description" as="description"/>
                </maybe>
            </sequence>
        </grammar>
    </tag>

    <tag name="phan-forbid-undeclared-magic-methods" class="TypeLang\PhpDoc\DocBlock\Tag\PhanForbidUndeclaredMagicMethodsTag\PhanForbidUndeclaredMagicMethodsTag" extends="TypeLang\PhpDoc\DocBlock\Tag\FlagTag" placement="block">
        <summary>
            The `@phan-forbid-undeclared-magic-methods` tag forbids calling
            undeclared magic methods on the class it decorates, so only documented
            methods may be called.
        </summary>
        <grammar>
            <maybe>
                <rule name="Description" as="description"/>
            </maybe>
        </grammar>
    </tag>

    <tag name="phan-forbid-undeclared-magic-properties" class="TypeLang\PhpDoc\DocBlock\Tag\PhanForbidUndeclaredMagicPropertiesTag\PhanForbidUndeclaredMagicPropertiesTag" extends="TypeLang\PhpDoc\DocBlock\Tag\FlagTag" placement="block">
        <summary>
            The `@phan-forbid-undeclared-magic-properties` tag forbids accessing
            undeclared magic properties on the class it decorates, so only
            documented properties may be accessed.
        </summary>
        <grammar>
            <maybe>
                <rule name="Description" as="description"/>
            </maybe>
        </grammar>
    </tag>

    <tag name="phan-hardcode-return-type" class="TypeLang\PhpDoc\DocBlock\Tag\PhanHardcodeReturnTypeTag\PhanHardcodeReturnTypeTag" extends="TypeLang\PhpDoc\DocBlock\Tag\TypedTag" placement="block">
        <summary>
            The `@phan-hardcode-return-type` tag forces the documented return type
            to be used instead of the type otherwise inferred from the method body.
        </summary>
        <grammar>
            <sequence>
                <rule name="Type" as="type" parameter="statement"/>
                <maybe>
                    <rule name="Description" as="description"/>
                </maybe>
            </sequence>
        </grammar>
    </tag>

    <tag name="phan-output-reference" class="TypeLang\PhpDoc\DocBlock\Tag\PhanOutputReferenceTag\PhanOutputReferenceTag" extends="TypeLang\PhpDoc\DocBlock\Tag\FlagTag" placement="block">
        <summary>
            The `@phan-output-reference` tag marks a by-reference argument as
            output-only.
        </summary>
        <grammar>
            <maybe>
                <rule name="Description" as="description"/>
            </maybe>
        </grammar>
    </tag>

    <tag name="phan-real-return" class="TypeLang\PhpDoc\DocBlock\Tag\PhanRealReturnTag\PhanRealReturnTag" extends="TypeLang\PhpDoc\DocBlock\Tag\TypedTag" placement="block">
        <summary>
            The `@phan-real-return` tag documents the actual native return type of a
            function or method, kept distinct from the documented `@return` type.
        </summary>
        <grammar>
            <sequence>
                <rule name="Type" as="type" parameter="statement"/>
                <maybe>
                    <rule name="Description" as="description"/>
                </maybe>
            </sequence>
        </grammar>
    </tag>

    <tag name="phan-side-effect-free" class="TypeLang\PhpDoc\DocBlock\Tag\PhanSideEffectFreeTag\PhanSideEffectFreeTag" extends="TypeLang\PhpDoc\DocBlock\Tag\FlagTag" placement="block">
        <summary>
            The `@phan-side-effect-free` tag declares a function or method as free
            of side effects.
        </summary>
        <grammar>
            <maybe>
                <rule name="Description" as="description"/>
            </maybe>
        </grammar>
    </tag>

    <tag name="phan-suppress-current-line" class="TypeLang\PhpDoc\DocBlock\Tag\PhanSuppressCurrentLineTag\PhanSuppressCurrentLineTag" extends="TypeLang\PhpDoc\DocBlock\Tag\IssueListTag" placement="block">
        <summary>
            The `@phan-suppress-current-line` tag silences the listed issue types
            reported on the current line.
        </summary>
        <grammar>
            <sequence>
                <rule name="IssueName" as="issue" parameter="issues"/>
                <repeat>
                    <sequence>
                        <literal value=","/>
                        <rule name="IssueName" as="issue" parameter="issues"/>
                    </sequence>
                </repeat>
                <maybe>
                    <rule name="Description" as="description"/>
                </maybe>
            </sequence>
        </grammar>
    </tag>

    <tag name="phan-suppress-next-line" class="TypeLang\PhpDoc\DocBlock\Tag\PhanSuppressNextLineTag\PhanSuppressNextLineTag" extends="TypeLang\PhpDoc\DocBlock\Tag\IssueListTag" placement="block">
        <summary>
            The `@phan-suppress-next-line` tag silences the listed issue types
            reported on the next line.
        </summary>
        <grammar>
            <sequence>
                <rule name="IssueName" as="issue" parameter="issues"/>
                <repeat>
                    <sequence>
                        <literal value=","/>
                        <rule name="IssueName" as="issue" parameter="issues"/>
                    </sequence>
                </repeat>
                <maybe>
                    <rule name="Description" as="description"/>
                </maybe>
            </sequence>
        </grammar>
    </tag>

    <tag name="phan-suppress-next-next-line" class="TypeLang\PhpDoc\DocBlock\Tag\PhanSuppressNextNextLineTag\PhanSuppressNextNextLineTag" extends="TypeLang\PhpDoc\DocBlock\Tag\IssueListTag" placement="block">
        <summary>
            The `@phan-suppress-next-next-line` tag silences the listed issue types
            reported two lines below the annotation.
        </summary>
        <grammar>
            <sequence>
                <rule name="IssueName" as="issue" parameter="issues"/>
                <repeat>
                    <sequence>
                        <literal value=","/>
                        <rule name="IssueName" as="issue" parameter="issues"/>
                    </sequence>
                </repeat>
                <maybe>
                    <rule name="Description" as="description"/>
                </maybe>
            </sequence>
        </grammar>
    </tag>

    <tag name="phan-suppress-previous-line" class="TypeLang\PhpDoc\DocBlock\Tag\PhanSuppressPreviousLineTag\PhanSuppressPreviousLineTag" extends="TypeLang\PhpDoc\DocBlock\Tag\IssueListTag" placement="block">
        <summary>
            The `@phan-suppress-previous-line` tag silences the listed issue types
            reported on the previous line.
        </summary>
        <grammar>
            <sequence>
                <rule name="IssueName" as="issue" parameter="issues"/>
                <repeat>
                    <sequence>
                        <literal value=","/>
                        <rule name="IssueName" as="issue" parameter="issues"/>
                    </sequence>
                </repeat>
                <maybe>
                    <rule name="Description" as="description"/>
                </maybe>
            </sequence>
        </grammar>
    </tag>

    <tag name="phan-transient" class="TypeLang\PhpDoc\DocBlock\Tag\PhanTransientTag\PhanTransientTag" extends="TypeLang\PhpDoc\DocBlock\Tag\FlagTag" placement="block">
        <summary>
            The `@phan-transient` tag marks a property as excluded from
            serialization.
        </summary>
        <grammar>
            <maybe>
                <rule name="Description" as="description"/>
            </maybe>
        </grammar>
    </tag>

    <tag name="phan-write-only" class="TypeLang\PhpDoc\DocBlock\Tag\PhanWriteOnlyTag\PhanWriteOnlyTag" extends="TypeLang\PhpDoc\DocBlock\Tag\FlagTag" placement="block">
        <summary>
            The `@phan-write-only` tag declares that a property may only ever be
            written, never read.
        </summary>
        <grammar>
            <maybe>
                <rule name="Description" as="description"/>
            </maybe>
        </grammar>
    </tag>

    <alias name="phan-abstract" of="abstract"/>
    <alias name="phan-assert" of="assert"/>
    <alias name="phan-assert-if-false" of="assert-if-false"/>
    <alias name="phan-assert-if-true" of="assert-if-true"/>
    <alias name="phan-extends" of="extends"/>
    <alias name="phan-immutable" of="immutable"/>
    <alias name="phan-inherits" of="extends"/>
    <alias name="phan-method" of="method"/>
    <alias name="phan-mixin" of="mixin"/>
    <alias name="phan-override" of="override"/>
    <alias name="phan-param" of="param"/>
    <alias name="phan-property" of="property"/>
    <alias name="phan-property-read" of="property-read"/>
    <alias name="phan-property-write" of="property-write"/>
    <alias name="phan-pure" of="pure"/>
    <alias name="phan-read-only" of="readonly"/>
    <alias name="phan-return" of="return"/>
    <alias name="phan-template" of="template"/>
    <alias name="phan-type" of="type"/>
    <alias name="phan-unused-param" of="unused-param"/>
    <alias name="phan-var" of="var"/>
    <alias name="phanclosurescope" of="phan-closure-scope"/>
</model>
